# Copy to .env.local for `node scripts/dev.js`; on Vercel set these in Project Settings > Environment Variables.
ADMIN_CODE=                      # the shared code the team types at /admin (pick something long)
SESSION_SECRET=                  # optional: a second random string that signs the admin cookie; defaults to ADMIN_CODE
KV_REST_API_URL=                 # from the Upstash for Redis integration on Vercel (Storage tab)
KV_REST_API_TOKEN=
RESEND_API_KEY=                  # from resend.com after verifying the foundersquare.org domain
MAIL_TO=team@foundersquare.org
MAIL_FROM=Founder Square <team@foundersquare.org>
